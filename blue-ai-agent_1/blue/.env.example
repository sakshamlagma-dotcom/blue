PORT=8787
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SEARCH_ONLY=false
HOST=127.0.0.1

# Required for the Assistant outside loopback development. Generate a random value of 32+ characters.
ASSISTANT_ACCESS_TOKEN=

# Optional AI assistant. Keep this key on the backend only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Search results require a SerpAPI account and a server-side key.
# The BLUE Search UI remains usable without it through DuckDuckGo Instant Answers
# and the external-search fallback.
SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=
SEARCH_REQUEST_TIMEOUT_MS=10000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_UPLOAD_MB=15
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_STEP_TIMEOUT_MS=30000
AGENT_TOTAL_TIMEOUT_MS=120000
